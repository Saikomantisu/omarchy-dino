#!/usr/bin/env python3
"""Read and update Dino's score file safely.

The shell never touches the file itself. This helper:
  - only uses a state directory that is a real directory, owned by the user,
    and not writable by group or others;
  - reads only a regular, owner-owned, single-link file, opened without
    following symlinks, and at most MAX_BYTES long;
  - writes through a private 0600 temporary file in that directory, then
    renames it over the old file, refusing to replace anything that is not
    an owner-owned regular file.

Usage: dino-scores read | submit <score> | reset
Prints the resulting state as JSON: {"highScore": n, "runs": n}
"""

import errno
import fcntl
import json
import os
import secrets
import stat
import sys

NAME = "scores.json"
MAX_BYTES = 4096
MAX_VALUE = 10**9


class Unsafe(Exception):
    pass


def state_dir():
    base = os.environ.get("XDG_STATE_HOME", "")
    if not os.path.isabs(base):
        base = os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "omarchy-dino")


def open_dir(path):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o022:
        os.close(fd)
        raise Unsafe("state directory is not a private directory owned by you: " + path)
    return fd


def check_file(st):
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1:
        raise Unsafe("score file is not a regular file owned by you")


def clean(value):
    try:
        n = int(value)
    except (TypeError, ValueError, OverflowError):
        return 0
    return max(0, min(MAX_VALUE, n))


def read_state(dirfd):
    try:
        fd = os.open(NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    except FileNotFoundError:
        return {"highScore": 0, "runs": 0}
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Unsafe("score file is a symlink")
        raise
    try:
        st = os.fstat(fd)
        check_file(st)
        if st.st_size > MAX_BYTES:
            raise Unsafe("score file is larger than %d bytes" % MAX_BYTES)
        data = os.read(fd, MAX_BYTES + 1)
    finally:
        os.close(fd)
    if len(data) > MAX_BYTES:
        raise Unsafe("score file is larger than %d bytes" % MAX_BYTES)
    try:
        parsed = json.loads(data.decode("utf-8") or "{}")
    except (UnicodeDecodeError, ValueError):
        parsed = {}
    if not isinstance(parsed, dict):
        parsed = {}
    return {"highScore": clean(parsed.get("highScore")), "runs": clean(parsed.get("runs"))}


def write_state(dirfd, state):
    try:
        check_file(os.stat(NAME, dir_fd=dirfd, follow_symlinks=False))
    except FileNotFoundError:
        pass

    tmp = ".%s.%s.tmp" % (NAME, secrets.token_hex(8))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dirfd)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (json.dumps(state, indent=2) + "\n").encode("utf-8"))
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.rename(tmp, NAME, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise


def main(argv):
    if not argv or argv[0] not in ("read", "submit", "reset") or (argv[0] == "submit" and (len(argv) != 2 or not argv[1].isdigit())):
        print("usage: dino-scores read | submit <score> | reset", file=sys.stderr)
        return 2

    dirfd = open_dir(state_dir())
    try:
        # Bar instances on several monitors share the file; serialize them.
        fcntl.flock(dirfd, fcntl.LOCK_EX)
        state = read_state(dirfd)
        if argv[0] == "submit":
            state["runs"] = clean(state["runs"] + 1)
            state["highScore"] = max(state["highScore"], clean(argv[1]))
            write_state(dirfd, state)
        elif argv[0] == "reset":
            state["highScore"] = 0
            write_state(dirfd, state)
    finally:
        os.close(dirfd)

    print(json.dumps(state))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Unsafe as e:
        print("dino-scores: refusing: %s" % e, file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        print("dino-scores: %s" % e, file=sys.stderr)
        sys.exit(1)
